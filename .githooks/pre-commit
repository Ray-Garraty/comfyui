#!/usr/bin/env bash
# Pre-commit gate: ruff (format + lint), pyright, pytest, shellcheck, bash -n.
# Installed via `git config core.hooksPath .githooks`; see AGENTS.md.
set -Eeuo pipefail

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

# One command owns the whole check matrix, so the hook cannot drift from
# `./provision.sh test` or from CI.
./provision.sh test
