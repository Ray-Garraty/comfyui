# Provisioning configuration for ComfyUI on this machine.
# Every value can be overridden from the environment, for example:
#   MODELS_DIR=/some/other/disk/models ./provision.sh all
#
# This file is sourced by bash; keep it free of command substitutions that
# depend on the caller's current directory.

# ---------------------------------------------------------------------------
# Paths
# ---------------------------------------------------------------------------
: "${INSTALL_DIR:=/home/vlabe/Documents/comfyui}"
: "${COMFYUI_DIR:=$INSTALL_DIR/ComfyUI}"
: "${VENV_DIR:=$INSTALL_DIR/venv}"
: "${LOG_DIR:=$INSTALL_DIR/logs}"

# Models live on the second NVMe (label BIG, ext4).
: "${BIG_MOUNT:=/media/vlabe/BIG}"
: "${BIG_UUID:=79284310-957b-49bb-bf5a-8a48ec082764}"
: "${BIG_DEVICE:=/dev/disk/by-uuid/$BIG_UUID}"
: "${MODELS_DIR:=$BIG_MOUNT/comfyui/models}"

: "${OUTPUT_DIR:=$INSTALL_DIR/output}"
: "${INPUT_DIR:=$INSTALL_DIR/input}"
: "${TEMP_DIR:=$INSTALL_DIR/temp}"
: "${USER_DIR:=$INSTALL_DIR/user}"

: "${HF_HOME:=$MODELS_DIR/.cache/huggingface}"
: "${TORCH_HOME:=$MODELS_DIR/.cache/torch}"

# ---------------------------------------------------------------------------
# Versions
# ---------------------------------------------------------------------------
# ComfyUI 0.42+ has native MOSS-Image support. 0.45.3 is the newest tag at the
# time this provisioning set was written.
: "${COMFYUI_REF:=v0.45.3}"
: "${MANAGER_REF:=4.3}"

# AMD multi-arch wheels. gfx1031 is detected automatically unless overridden.
: "${GPU_GFX:=auto}"
: "${TORCH_INDEX:=https://stable.repo.amd.com/rocm/whl-next/}"
: "${TORCH_VERSION:=2.13.0}"
: "${TORCHVISION_VERSION:=0.28.0}"
: "${TORCHAUDIO_VERSION:=2.11.0.2}"
: "${ROCM_VERSION:=10.1.0}"

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
: "${COMFYUI_LISTEN:=127.0.0.1}"
: "${COMFYUI_PORT:=8188}"
# 12 GB VRAM is shared with the desktop: the display plane needs memory for
# scanout even while a 7 GB text encoder and a 5.8 GB diffusion model are
# staged, otherwise the kernel logs 'Failed to pin framebuffer with error -12'.
: "${COMFYUI_RESERVE_VRAM:=1.5}"
: "${COMFYUI_LOWVRAM:=0}"
# Two log files: INFO to comfyui.log, DEBUG to comfyui-debug.log.
: "${COMFYUI_LOG_LEVEL:=INFO}"
: "${COMFYUI_DEBUG_LOG:=1}"
# Seconds between fsync calls on the log files while ComfyUI runs (0 disables).
: "${LOG_SYNC_INTERVAL:=5}"
: "${COMFYUI_EXTRA_ARGS:=}"

# ---------------------------------------------------------------------------
# Credentials
# ---------------------------------------------------------------------------
: "${CONFIG_HOME:=$HOME/.config/comfyui}"
: "${CIVITAI_TOKEN_FILE:=$CONFIG_HOME/civitai.token}"
: "${HF_TOKEN_FILE:=$CONFIG_HOME/hf.token}"

# ---------------------------------------------------------------------------
# Behaviour
# ---------------------------------------------------------------------------
: "${INSTALL_MANAGER:=1}"
: "${CREATE_DESKTOP_ICON:=1}"
# Swap is not optional on a 32 GB box that pins up to 16 GiB of host memory.
: "${ENABLE_SWAP:=1}"
: "${SWAP_SIZE:=16G}"
: "${SWAP_FILE:=/swapfile}"
# Journald/rsyslog tuning, watchdog panics and pstore collection.
: "${ENABLE_CRASH_CAPTURE:=1}"
